FAB_DEPLOYMENT_PROFILE=local
# local preserves workstation compatibility; windows/vm require strong secrets.
# Port fallback is allowed only with local + NODE_ENV=development.
PORT=3000
FAB_WEB_HOST=127.0.0.1
FAB_LOCAL_API_URL=http://127.0.0.1:5001
FAB_LOCAL_API_PUBLIC_URL=http://127.0.0.1:5001
# vm requires both public origins as HTTPS origins without paths or credentials:
# FAB_OPERATOR_PUBLIC_ORIGIN=https://fab.example.test
# FAB_LOCAL_API_PUBLIC_URL=https://ledger.example.test
# Internal FAB_LOCAL_API_URL may remain HTTP on the private service network.
# Trust only the exact reverse-proxy IP addresses; empty means trust no proxy.
# The trusted proxy must overwrite X-Forwarded-For/Host/Proto headers.
FAB_OPERATOR_TRUSTED_PROXY_ADDRESSES=

# windows/vm: use independently generated random secrets, at least 32 characters.
# Missing, short, repetitive, and known placeholder values fail startup.
FAB_LOCAL_API_TOKEN=
FAB_OPERATIONS_SERVICE_TOKEN=
JWT_SECRET=
# Alternatively use mounted, read-only UTF-8 files (one line; max 65536 bytes).
# Remove the corresponding inline variable entirely when enabling *_FILE.
# Even an empty inline variable conflicts with a configured *_FILE variable.
# FAB_LOCAL_API_TOKEN_FILE=/run/secrets/fab_local_api_token
# FAB_OPERATIONS_SERVICE_TOKEN_FILE=/run/secrets/fab_operations_service_token
# JWT_SECRET_FILE=/run/secrets/fab_jwt_secret
# Shutdown drains requests for at most 10 seconds, then closes remaining sockets.
FAB_BILLING_ENABLED=false
FAB_OPERATOR_LOCAL_MODE=true

# Optional legacy SaaS sign-in, full server only (not standalone/managed auth).
# The browser starts at /api/oauth/start. All four values are server runtime config.
# VITE_APP_ID=your-provider-application-id
# VITE_OAUTH_PORTAL_URL=https://your-identity-portal.example
# OAUTH_SERVER_URL=https://your-identity-api.example
# OAUTH_REDIRECT_URI=https://fab.example.test/api/oauth/callback
# Register that exact callback URI at the provider. HTTP is accepted only for
# an explicit localhost/127.0.0.1/[::1] callback with its real listening port.
# Pending logins expire in 10 minutes and are invalidated on server restart.
