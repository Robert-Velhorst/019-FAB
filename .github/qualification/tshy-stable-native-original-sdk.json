  "owned_cli_source_files": [
    {
      "path": "bin/tsgo.cjs",
      "sha256": "588c855eebc84296ca116e5e4785f09994b77fdd65c3120882a4a5a68371de6d",
      "content": "#!/usr/bin/env node\n'use strict';\n// Production CLI compatibility only: forward unchanged arguments to the real\n// stable native compiler. No compiler flags, source inputs or diagnostics change.\nconst fs = require('node:fs');\nconst path = require('node:path');\nconst crypto = require('node:crypto');\nconst {spawnSync} = require('node:child_process');\nconst packagePath = require.resolve('typescript/package.json');\nconst metadata = JSON.parse(fs.readFileSync(packagePath, 'utf8'));\nif (metadata.version !== '7.0.2' || metadata.bin.tsc !== 'bin/tsc') {\n  throw new Error('Expected the declared stable TypeScript 7.0.2 native compiler');\n}\nconst launcher = path.join(path.dirname(packagePath), metadata.bin.tsc);\nconst args = process.argv.slice(2);\nconst receipt = {\n  compiler_package: metadata.name, compiler_version: metadata.version,\n  compiler_launcher: launcher,\n  compiler_launcher_sha256: crypto.createHash('sha256').update(fs.readFileSync(launcher)).digest('hex'),\n  argv: args, node: process.version,\n};\nif (process.env.OWNED_NATIVE_COMPILER_TRACE === '1') {\n  process.stderr.write('OWNED_NATIVE_COMPILER '+JSON.stringify(receipt)+'\\n');\n}\nconst result = spawnSync(process.execPath, [launcher, ...args], {stdio:'inherit'});\nif (result.error) throw result.error;\nif (result.signal) process.kill(process.pid, result.signal);\nelse process.exitCode = result.status === null ? 1 : result.status;\n"
    },
